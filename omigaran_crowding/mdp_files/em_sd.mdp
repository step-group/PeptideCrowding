; em_sd.mdp - steepest descent, stage 1 of 2
integrator      = steep       ; steepest descent minimization
emtol           = 1000.0      ; stop when Fmax < 1000 kJ/mol/nm
emstep          = 0.001       ; initial step size (GROMACS auto-adjusts)
nsteps          = 50000

nstlist         = 1
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
rvdw            = 1.2
vdw-modifier    = Potential-shift-Verlet
DispCorr        = EnerPres
pbc             = xyz

constraints     = none